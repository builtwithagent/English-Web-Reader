# 英文网页阅读器 · 后端环境变量模板
#
# 用法：复制成 .env 再填值。`cp .env.example .env`
# .env 已被 .gitignore 排除，**不要把真实密钥写进这个模板文件**。

# ---- 服务端口 ----
# 本地开发默认 3000（vite 的 server.proxy 就是往这儿转的）
# 发布沙箱会注入自己的 PORT，覆盖这里
PORT=3000

# ---- DeepSeek 上游（技术方案 5.1 / 5.5）----
#
# 必填。这个值**只存在于服务端**，绝不出现在前端代码、日志或错误消息里。
# 拿密钥：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 可选。默认 https://api.deepseek.com
# 做端到端测试时可以指向本地 Mock 上游（配合 scripts/ 下的验收脚本）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选。默认 deepseek-v4-flash
# 注意：`deepseek-chat` / `deepseek-reasoner` 已于 2026-07 废弃，会直接报错
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选。单块翻译超时，毫秒，默认 30000
DEEPSEEK_TIMEOUT_MS=30000
