# 英文网页阅读器 · 后端环境变量模板
#
# 用法：复制成 .env 再填值。`cp .env.example .env`
# .env 已被 .gitignore 排除，**不要把真实密钥写进这个模板文件**。

# ---- 服务端口 ----
# 本地开发默认 3000（vite 的 server.proxy 就是往这儿转的）
# 发布沙箱会注入自己的 PORT，覆盖这里
PORT=3000

# ---- LLM 上游（技术方案 5.1 / 5.5）----
#
# 接的是**任何 OpenAI 兼容端点**。这里以智谱 GLM 为例（免费档 glm-4-flash）。
# 想换别家（通义千问 / 火山方舟 / 硅基流动 / OpenRouter …）只改下面三行值即可，
# 代码与文档一行都不用动 —— 这就是配置项命名用中性 `LLM_*` 的原因。
#
# 必填。这个值**只存在于服务端**，绝不出现在前端代码、日志或错误消息里。
# 拿密钥：https://open.bigmodel.cn → 「API Keys」
LLM_API_KEY=

# 可选。默认 https://open.bigmodel.cn/api/paas/v4
# **末尾的 `/v4` 不能省**：服务拼的是 `${baseUrl}/chat/completions`。
# 做端到端测试时可以指向本地 Mock 上游（配合 scripts/ 下的验收脚本）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选。默认 glm-4-flash（免费档）
# 上游模型名会变（下架/改名/进 legacy 名单），以官方文档当前写法为准：
# https://open.bigmodel.cn/dev/api
LLM_MODEL=glm-4-flash

# 可选。单块翻译超时，毫秒，默认 30000
LLM_TIMEOUT_MS=30000

# ---- 额度闸门（可选，公开上线后建议保留默认值）----
#
# 这三项挡的是"把我们的上游额度刷光"和"把出网 IP 打到别人黑名单上"。
# 机制与取舍写在 server/src/common/rate-limit.ts 的文件头，这里只说怎么配：
#
# 数值**留空 = 用默认值**；填 0 或负数 = **关掉这道闸门**（不限）；
# 填了不是数字的东西 = 回落到默认值（刻意不"关掉"：配置写错时宁可继续保护）。
# 生效值在启动日志里会打出来（找 "翻译额度：" / "抓取额度：" 两行）。
#
# 可译块数 ≈ 一篇文章 50 块（纯数字行、代码块、图片不算），折算参考：
#   1500 块/天 ≈ 30 篇，15000 块/天 ≈ 300 篇。
#
# 每 IP 每分钟的翻译请求数，默认 6。挡"脚本没加 sleep"这类连发
TRANSLATE_PER_MINUTE=6
# 每 IP 每天的翻译块数，默认 1500
TRANSLATE_BLOCKS_PER_IP_PER_DAY=1500
# 全站每天的翻译块数，默认 15000 —— **这才是真正保钱的总闸**。
# 前两项靠 IP 算，而 X-Forwarded-For 可以伪造；这一项挡不住的人，前两项也挡不住
TRANSLATE_BLOCKS_PER_DAY=15000

# 每 IP 每分钟的抓取次数，默认 20
ARTICLE_PER_MINUTE=20
# 每 IP 每天的抓取页面数，默认 1000
ARTICLE_PAGES_PER_IP_PER_DAY=1000
# 全站每天的抓取页面数，默认 0 = **不限**。
# 抓取不花上游的钱，而"用得多"本身是好事；真被爬虫群打了再拉上这道闸
ARTICLE_PAGES_PER_DAY=0

# ---- 访问统计（可选）----
#
# 保护 `GET /api/stats`。浏览器里的 `/stats` 是个前端路由页面，数据就来自这个接口，
# 所以密码把在接口这一处就够了（页面本身公开无妨 —— 拿不到数据只会看到输入框）。
#
# 不填 = 这个接口直接返回 503，也就是**关着**（不是"不校验"）。
# 本地开发一般用不到，发布上线后**必须**填一个强密码再上线。
#
# 密码怎么送：页面自己收，放在自定义头 `X-Stats-Key` 里。也兼容标准
# `Authorization: Basic`，但那只是兼容 —— 发布环境的网关会用自己的 Bearer token
# 覆盖 `Authorization`，那条路在线上走不通（详见 server/src/stats/stats.auth.ts）。
# 输一次记在这个标签页的 sessionStorage 里，也可以用 `/stats?key=密码` 一次进来。
#
# 注意：密码是明文随每个请求发的，所以只在 HTTPS 下才安全。
STATS_PASSWORD=

# 可选。用户名，默认 admin —— **只有走 `Authorization: Basic` 那条路时才用得上**，
# 页面自己收密码的那条路不需要用户名
STATS_USER=admin
