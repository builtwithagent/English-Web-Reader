{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2023",
    // DOM 是必需的：@mozilla/readability 与 jsdom 的类型都建立在 lib.dom 之上，
    // 只给 ES2023 会直接报 `Cannot find name 'Document'`。
    // 这里只是借用它的类型，运行时并不存在全局 document（DOM 来自 jsdom 实例）。
    "lib": ["ES2023", "DOM"],
    "sourceMap": true,
    "outDir": "./dist",
    // TS 6/7 起 rootDir 必须显式声明（决定 dist 的目录层级），否则直接报 TS5011。
    "rootDir": "./src",
    "incremental": true,
    // 增量编译的记忆文件**必须放在 outDir 里面**。
    // 放外面（默认的 tsconfig.tsbuildinfo）踩过两次：`rm -rf dist` 之后跑 build，
    // tsc 按记忆认为"未改动的文件都已产出"，**直接跳过它们** —— 于是 dist 只补出
    // 少数几个文件，而退出码是 0。表现为启动时报 `Cannot find module './xxx.controller'`，
    // 排查方向会被带偏到模块解析上。
    // 放进 dist 之后，"删产物"和"删记忆"变成同一个动作，这类失败不可能再发生。
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
